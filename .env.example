DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/finora"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
REQUIRE_EMAIL_VERIFICATION="false"
# Producción: usar HTTPS, secreto aleatorio y SMTP; activar verificación de email.
# SMTP_URL="smtps://USER:PASSWORD@smtp.example.com:465"
# EMAIL_FROM="Finora <hola@example.com>"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Callback Google: /api/auth/callback/google en BETTER_AUTH_URL
# Opcional, comandos de respaldo: directorio con pg_dump y pg_restore.
# PG_BIN_DIR="C:/ruta/postgresql/bin"
# Restauración manual: conexión a otra base vacía, nunca la base origen.
# RESTORE_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/finora_restore"
